{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumi-agents-control-plane-api",
  "main": "build/index.js",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "build": {
    "command": "cargo install --locked worker-build --version \"^0.8\" && worker-build --release"
  }
}
